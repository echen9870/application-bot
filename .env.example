# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit it.

# Anthropic API key, for the resume-parsing / description-cleanup steps.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# The ID of YOUR Google Sheet — the long string in the sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# The sheet needs three tabs: Potential, Applied, Ignored.
GOOGLE_SPREADSHEET_ID=YOUR_SPREADSHEET_ID

# Path to your Google service-account JSON key (gitignored).
# Create a service account in the Google Cloud Console, enable the Sheets API,
# download its JSON key, and share your spreadsheet with the service account's
# email address (…@….iam.gserviceaccount.com) as an Editor.
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json

# Cloud runs (no key file on disk): put the key file's whole JSON contents in this
# variable instead. When set, it takes precedence over GOOGLE_SERVICE_ACCOUNT_PATH.
# GOOGLE_SERVICE_ACCOUNT_JSON=
