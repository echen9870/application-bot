{
  "name": "career-ops",
  "version": "1.0.0",
  "description": "AI-powered job search pipeline built on Claude Code",
  "scripts": {
    "scan": "node src/jobs.mjs && node src/prune.mjs && node src/score.mjs",
    "scan:dry": "node src/jobs.mjs --dry-run",
    "scan:all": "node src/jobs.mjs --all && node src/prune.mjs && node src/score.mjs",
    "jobs": "node src/jobs.mjs",
    "jobs:dry": "node src/jobs.mjs --dry-run",
    "apply": "node src/apply.mjs",
    "apply:dry": "node src/apply.mjs --dry-run",
    "prune": "node src/prune.mjs",
    "prune:dry": "node src/prune.mjs --dry-run",
    "score": "node src/score.mjs",
    "score:dry": "node src/score.mjs --dry-run",
    "train": "node src/train.mjs",
    "train:bootstrap": "node src/train.mjs --bootstrap",
    "probe": "node src/probe-ats.mjs",
    "probe:apply": "node src/probe-ats.mjs --apply",
    "liveness": "node src/check-liveness.mjs",
    "test": "node test/test-all.mjs",
    "test:ml": "node test/test-ml.mjs",
    "test:ml:mock": "node test/test-ml.mjs --mock-resume"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "career",
    "automation"
  ],
  "author": "Eric Chen <echen9870@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/echen9870/application-bot"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.5",
    "googleapis": "^171.4.0",
    "js-yaml": "^4.1.1",
    "pdf-parse": "^2.4.5"
  }
}
